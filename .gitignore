# MRI 缓存数据（体积过大，不纳入版本控制）
data/mri_cache/

# 配准到标准模板的结果缓存（experiments/healthy_subset_registered.py 补充实验，
# 体积过大且可由 register_healthy_subset_mri.py 重新生成，不纳入版本控制）
data/mri_registered_cache/

# MNI152 标准模板下载缓存（nilearn.datasets.fetch_icbm152_2009，体积较大且可
# 自动重新下载，不纳入版本控制）
data/mni_template/

# 预训练模型下载缓存（HuggingFace Hub / torch.hub，体积过大，不纳入版本控制）
data/model_cache/

# 本地密钥/token（如 TABPFN_TOKEN），绝不纳入版本控制
.env.local

# Python 字节码缓存（自动生成，与环境绑定，不纳入版本控制）
__pycache__/
*.pyc
*.pyo

# LaTeX 写作文件夹（本地使用，不纳入版本控制）
latex/

# 训练/测试结果输出（含模型 checkpoint 等大文件，体积过大且属于运行产物，不纳入版本控制）
results/
